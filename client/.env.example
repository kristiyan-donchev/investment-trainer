# Copy this file to .env and fill in your own values.

# Only needed in production, where the frontend and backend are on different
# domains (e.g. Vercel + Render). Leave unset for local dev — Vite's dev
# server proxies /api requests to the backend automatically (see vite.config.js).
VITE_API_BASE_URL=https://your-backend-url.example.com

# Google AdSense. The Auto ads script (site-wide ad placement) is loaded
# unconditionally in index.html, so ads work without any of this. These two
# vars are only for a manual ad unit in the dashboard right rail:
# VITE_ADSENSE_CLIENT_ID defaults to the site's real publisher ID (see
# index.html) if left unset. VITE_ADSENSE_SLOT_RAIL is the ad unit ID for
# that slot — create a "Display ad" unit at https://www.google.com/adsense to
# get one; leave unset to render nothing there and rely on Auto ads alone.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_RAIL=
