# Copy this file to .env and fill in your own values.

# Only needed in production, where the frontend and backend are on different
# domains (e.g. Vercel + Render). Leave unset for local dev — Vite's dev
# server proxies /api requests to the backend automatically (see vite.config.js).
VITE_API_BASE_URL=https://your-backend-url.example.com

# Google AdSense (optional). Leave both unset to render a plain placeholder
# box instead of a real ad — useful for local dev and before your account is
# approved. Get these from https://www.google.com/adsense once you've signed
# up: VITE_ADSENSE_CLIENT_ID is your publisher ID (ca-pub-XXXXXXXXXXXXXXXX),
# VITE_ADSENSE_SLOT_RAIL is the ad unit ID for the dashboard right-rail slot.
# You'll also need an ads.txt at the site root — ask to have it added once
# you have your publisher ID.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_RAIL=
